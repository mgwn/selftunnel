build.sh
docker-compose.yml
docker-compose.runtime.yml
.github/

# Local binaries: Dockerfile and Dockerfile.build compile from source.
# selftunnel-server-linux is intentionally NOT excluded here — Dockerfile.runtime COPYs it.
selftunnel-server
selftunnel-client
selftunnel-client-gui
selftunnel-client.exe

# OS files
.DS_Store
Thumbs.db

