#!/usr/bin/env bash
# Commit message lint for tunnel-relay (Conventional Commits, see AGENTS.md).
#
# The subject line (first line) must match:
#
#   <type>(<scope>)?!?: <subject>
#
#   type:   feat | fix | docs | style | test | refactor | perf | build |
#           ci | chore | revert
#   scope:  optional, lowercase alphanumerics/dashes (e.g. server, client)
#   !:      optional, marks a breaking change
#
# Merge commits ("Merge …") and git's automated reverts are exempt.
set -euo pipefail

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ]; then
  echo "commit-msg: no message file given" >&2
  exit 1
fi

FIRST_LINE="$(head -n1 "$MSG_FILE")"

# Exemptions: merge commits and automated reverts.
if echo "$FIRST_LINE" | grep -qE '^(Merge |Revert ")'; then
  exit 0
fi

PATTERN='^(feat|fix|docs|style|test|refactor|perf|build|ci|chore|revert)(\([a-z0-9][a-z0-9-]*\))?!?: .+'

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  cat >&2 <<EOF
commit-msg: invalid subject line:

  ${FIRST_LINE}

Expected Conventional Commits format:

  <type>(<scope>)?!?: <subject>

Types: feat fix docs style test refactor perf build ci chore revert
Scope is optional, e.g. server, client, gui, docs, ci.

Examples:
  feat(server): add -debug request logging
  fix(client): unblock pending reads on context cancellation
  docs: expand the testing section in the README
  refactor(server)!: split the relay timeout into two stages
EOF
  exit 1
fi

exit 0
